POSTGRES_USER=ai_assistant
POSTGRES_PASSWORD=ai_customer_assistant_password
POSTGRES_DB=ai_customer_assistant
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=knowledge-documents
MINIO_SECURE=false

TIKA_BASE_URL=http://localhost:9998

APP_ENV=development
APP_PORT=8000
APP_PUBLIC_URL=http://localhost:8000

# SMTP (use a Gmail App Password, not your normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_USE_TLS=true
TICKET_VERIFICATION_TTL_MINUTES=30

GROQ_API_KEY=your_real_groq_key
# Model used for customer-chat request classification.
GROQ_MODEL=openai/gpt-oss-120b

EAV_MODEL=openai/gpt-oss-120b
EAV_EXTRACTION_REQUIRED=false

INGESTION_CHUNK_SIZE_TOKENS=500
INGESTION_CHUNK_OVERLAP_TOKENS=75
INGESTION_EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
INGESTION_EMBEDDING_DIMENSION=768
INGESTION_NORMALIZE_EMBEDDINGS=true
